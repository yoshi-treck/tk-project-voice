{
    "rewrites": [
        {
            "source": "/voice/static/(.*)",
            "destination": "/static/$1"
        },
        {
            "source": "/voice/run-macro",
            "destination": "/main.py"
        },
        {
            "source": "/voice",
            "destination": "/main.py"
        },
        {
            "source": "/voice/",
            "destination": "/main.py"
        },
        {
            "source": "/voice/(.*)",
            "destination": "/main.py"
        },
        {
            "source": "/",
            "destination": "/main.py"
        }
    ],
    "cleanUrls": true,
    "trailingSlash": true
}